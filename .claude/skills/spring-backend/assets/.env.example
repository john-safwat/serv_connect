# Copy to .env for local docker compose usage. Never commit the real .env file.

# Postgres (used by compose.yaml)
DATABASE=app
DATABASE_USERNAME=changeme
DATABASE_PASSWORD=changeme

# Spring datasource (used by application-dev/prod)
DATABASE_URL=jdbc:postgresql://localhost:5432/app

# Active Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=prod

# JWT — JWT_SECRET must be Base64-encoded and long enough for HMAC-SHA (256+ bits).
JWT_SECRET=changeme
JWT_TOKEN_EXPIRY_TIME=3600000
JWT_REFRESH_TOKEN_EXPIRY_TIME=604800000

# Redis cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP / Mail
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
