# Copy to .env (gitignored) and fill in. Never commit real values.
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (required in prod)
# prod: must use TLS, e.g. jdbc:postgresql://host:5432/db?sslmode=verify-full (or at least require)
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Redis (required in prod)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
# prod: Redis uses TLS by default; set false only on a private non-TLS network
# REDIS_SSL_ENABLED=true

# Comma-separated dashboard origins allowed by CORS (required in prod; never "*")
CORS_ALLOWED_ORIGINS=

# Added by later plans, listed here so environments are provisioned once:
# JWT_SECRET, JWT_TOKEN_EXPIRY_TIME, JWT_REFRESH_TOKEN_EXPIRY_TIME, OFFLINE_GRACE_DAYS,
# FIELD_ENCRYPTION_KEY, S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY, S3_SECRET_KEY,
# FCM_CREDENTIALS_PATH, SMTP_*, SMS_*

# Local compose only: override host ports if 5432 / 6379 are already taken.
# POSTGRES_PORT=5432
# REDIS_PORT (above) is dual-use: the Redis port the app connects to in prod, and the host port
# compose publishes locally (the dev profile discovers the mapped port automatically).
