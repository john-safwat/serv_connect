# ServeConnect Web Dashboard — Environment Configuration
# Copy to .env.development, .env.staging, or .env.production.
# NEVER put secrets, private API keys, or service-account credentials in VITE_* variables.

VITE_API_BASE_URL=__VITE_API_BASE_URL__
VITE_ENV_NAME=dev
VITE_DEFAULT_LOCALE=en
VITE_IDLE_TIMEOUT_MINUTES=15
